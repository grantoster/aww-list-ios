default_platform(:ios)

platform :ios do
  desc "Build a signed release and upload it to TestFlight"
  lane :beta do
    key_path = File.expand_path("AuthKey.p8")
    File.write(key_path, ENV.fetch("ASC_KEY_P8"))
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: key_path
    )

    # Creates the app record the first time (name must be unique on the App Store).
    produce(
      api_key: api_key,
      app_identifier: ENV.fetch("AWW_BUNDLE_ID"),
      app_name: ENV.fetch("APP_NAME", "Aww List – Cutest Photos"),
      team_id: ENV.fetch("AWW_TEAM_ID"),
      skip_itc: false
    ) rescue UI.important("App record already exists")

    increment_build_number(xcodeproj: "AwwList.xcodeproj", build_number: (Time.now.to_i / 60).to_s)

    build_app(
      project: "AwwList.xcodeproj",
      scheme: "AwwList",
      export_method: "app-store",
      xcargs: "AWW_TEAM_ID=#{ENV['AWW_TEAM_ID']} AWW_BUNDLE_ID=#{ENV['AWW_BUNDLE_ID']} -allowProvisioningUpdates " \
              "-authenticationKeyPath #{key_path} -authenticationKeyID #{ENV['ASC_KEY_ID']} -authenticationKeyIssuerID #{ENV['ASC_ISSUER_ID']}"
    )

    upload_to_testflight(api_key: api_key, skip_waiting_for_build_processing: true)
  end
end
