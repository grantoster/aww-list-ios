default_platform(:ios)

platform :ios do
  desc "Build a signed release and upload it to TestFlight"
  lane :beta do
    key_path = File.expand_path("AuthKey.p8")
    File.write(key_path, ENV.fetch("ASC_KEY_P8"))
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: key_path
    )
    team = ENV.fetch("AWW_TEAM_ID")
    bundle = ENV.fetch("AWW_BUNDLE_ID")
    auth = "-allowProvisioningUpdates -authenticationKeyPath #{key_path} " \
           "-authenticationKeyID #{ENV['ASC_KEY_ID']} -authenticationKeyIssuerID #{ENV['ASC_ISSUER_ID']}"

    build_app(
      project: "AwwList.xcodeproj",
      scheme: "AwwList",
      export_method: "app-store"   # the runner's fastlane predates the "app-store-connect" name; Xcode maps it,
      export_team_id: team,
      xcargs: "AWW_TEAM_ID=#{team} AWW_BUNDLE_ID=#{bundle} CURRENT_PROJECT_VERSION=#{Time.now.to_i / 60} #{auth}",
      export_xcargs: auth
    )

    upload_to_testflight(api_key: api_key, skip_waiting_for_build_processing: true)
  end
end
