require 'time'
default_platform(:ios)

platform :ios do
  # Errors also go to the run's annotations (the full log can't be read from here).
  error do |lane, exception|
    puts "::error::#{lane}: #{exception.message.to_s.gsub("\n", " ")[0, 900]}"
  end

  desc "Build a signed release and upload it to TestFlight"
  lane :beta do
    # Temporary keychain on the CI Mac for this run's signing certificate.
    setup_ci(keychain_name: "aww_ci")
    keychain = File.expand_path("~/Library/Keychains/aww_ci-db")

    key_path = File.expand_path("AuthKey.p8")
    File.write(key_path, ENV.fetch("ASC_KEY_P8"))
    api_key = app_store_connect_api_key(
      key_id: ENV.fetch("ASC_KEY_ID"),
      issuer_id: ENV.fetch("ASC_ISSUER_ID"),
      key_filepath: key_path
    )
    team = ENV.fetch("AWW_TEAM_ID")
    bundle = ENV.fetch("AWW_BUNDLE_ID")
    profile = "AwwListCI#{Time.now.to_i}"   # a new, uniquely named profile each run (old ones die with their certificate)
    cert_id = nil
    uploaded = false    # an upload Apple hasn't finished processing must keep its certificate
    processed = false

    begin
      # A fresh Apple Distribution certificate for this run only (the cloud Mac keeps nothing between runs).
      # It is revoked again at the end so the account never hits Apple's certificate limit; revoking it
      # does not affect builds already uploaded to TestFlight or the App Store.
      # Builds that were cancelled midway never got to revoke their certificate, and Apple allows only a few.
      # Revoke Apple Distribution certificates made more than 2 hours ago (any build still using one has long
      # finished). Approved by the owner: this account's Distribution certificates are only used by these builds.
      Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.from(hash: api_key)
      Spaceship::ConnectAPI::Certificate.all.each do |c|
        next unless %w[DISTRIBUTION IOS_DISTRIBUTION].include?(c.certificate_type)
        made = Time.parse(c.expiration_date) - 365 * 24 * 3600
        next unless made < Time.now - 2 * 3600
        begin
          c.delete!
          UI.message("Revoked an old build certificate (#{c.id})")
        rescue => e
          UI.important("Could not revoke old certificate #{c.id}: #{e.message}")
        end
      end
      get_certificates(api_key: api_key, force: true, generate_apple_certs: true,
                       keychain_path: keychain, keychain_password: "")
      cert_id = lane_context[SharedValues::CERT_CERTIFICATE_ID]

      # An App Store provisioning profile for that certificate (needs no registered devices).
      get_provisioning_profile(api_key: api_key, app_identifier: bundle, force: true,
                               cert_id: cert_id, provisioning_name: profile)
      profile = lane_context[SharedValues::SIGH_NAME] || profile

      build_app(
        project: "AwwList.xcodeproj",
        scheme: "AwwList",
        configuration: "Release",
        export_method: "app-store",   # runner fastlane predates the "app-store-connect" name; Xcode maps it
        export_team_id: team,
        xcargs: "AWW_TEAM_ID=#{team} AWW_BUNDLE_ID=#{bundle} CURRENT_PROJECT_VERSION=#{Time.now.to_i / 60} " \
                "CODE_SIGN_STYLE=Manual CODE_SIGN_IDENTITY='Apple Distribution' PROVISIONING_PROFILE_SPECIFIER=#{profile}",
        export_options: { signingStyle: "manual", provisioningProfiles: { bundle => profile } }
      )

      # Wait for Apple to finish processing, so a build Apple rejects fails this run instead of silently vanishing.
      uploaded = true
      upload_to_testflight(api_key: api_key, skip_waiting_for_build_processing: false,
                           wait_processing_timeout_duration: 3600)
      processed = true
      UI.message("::notice::TestFlight build #{lane_context[SharedValues::BUILD_NUMBER] || ''} processed")
    ensure
      # Revoking the certificate before Apple finishes processing the upload makes Apple reject the build
      # (ITMS-90721), so it's only revoked once processing is done, or when nothing was uploaded.
      if cert_id && uploaded && !processed
        puts "::warning::Kept this run's signing certificate (#{cert_id}): the upload wasn't confirmed as processed."
      elsif cert_id
        begin
          Spaceship::ConnectAPI::Certificate.get(certificate_id: cert_id).delete!
          UI.message("Revoked this run's signing certificate")
        rescue => e
          UI.important("Could not revoke certificate #{cert_id}: #{e.message}")
        end
      end
    end
  end
end
